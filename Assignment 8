#include <stdio.h>
#include <string.h>

#define MAX 100

struct Sensor {
    int id;
    char type[30];
    float reading, min, max;
};

void accept(struct Sensor *s, int n) {
    for (int i = 0; i < n; i++) {
        printf("\nEnter Sensor ID: ");
        scanf("%d", &s[i].id);
        printf("Enter Sensor Type: ");
        scanf("%29s", s[i].type);
        printf("Enter Reading, Minimum and Maximum: ");
        scanf("%f%f%f", &s[i].reading, &s[i].min, &s[i].max);

        if (s[i].min > s[i].max) {
            printf("Invalid range!\n");
            i--;
        }
    }
}

void classify(struct Sensor *s, int n) {
    for (int i = 0; i < n; i++)
        printf("\nSensor %d: %s", s[i].id,
        (s[i].reading >= s[i].min && s[i].reading <= s[i].max)
        ? "NORMAL" : "ABNORMAL");
}

void average(struct Sensor *s, int n) {
    char type[30];
    float sum = 0;
    int count = 0;

    printf("\n\nEnter Sensor Type for Average: ");
    scanf("%29s", type);

    for (int i = 0; i < n; i++)
        if (strcmp(s[i].type, type) == 0) {
            sum += s[i].reading;
            count++;
        }

    if (count)
        printf("Average Reading = %.2f\n", sum / count);
    else
        printf("Sensor Type Not Found!\n");
}

void abnormal(struct Sensor *s, int n) {
    int found = 0;
    printf("\nAbnormal Sensors:\n");

    for (int i = 0; i < n; i++)
        if (s[i].reading < s[i].min || s[i].reading > s[i].max) {
            printf("ID: %d Type: %s Reading: %.2f\n",
                   s[i].id, s[i].type, s[i].reading);
            found = 1;
        }

    if (!found)
        printf("No Abnormal Sensors Found!\n");
}

int main() {
    struct Sensor s[MAX];
    int n;

    printf("Enter Number of Sensors: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX) {
        printf("Invalid Number!\n");
        return 1;
    }

    accept(s, n);
    printf("\nSensor Classification:\n");
    classify(s, n);
    average(s, n);
    abnormal(s, n);

    return 0;
}
